# Public URLs embedded into signed release metadata/client. HTTPS is mandatory.
# Entitlement origin also serves the authenticated zKillboard/R2Z2 relay.
FLY_SAFE_ENTITLEMENT_API_URL=https://license.example.com
# Optional dedicated endpoint. Falls back to the entitlement origin when omitted.
FLY_SAFE_COMBAT_RELAY_URL=https://combat.example.com
FLY_SAFE_UPDATE_URL=https://updates.example.com

# Code-signing certificate accepted by electron-builder (P12 path, file URL or base64).
CSC_LINK=/absolute/path/to/fly-safe-signing.p12
CSC_KEY_PASSWORD=replace-me

# macOS notarization: Apple ID flow...
APPLE_ID=developer@example.com
APPLE_APP_SPECIFIC_PASSWORD=replace-me
APPLE_TEAM_ID=ABCDE12345

# ...or App Store Connect API-key flow.
# APPLE_API_KEY=/absolute/path/to/AuthKey_ABCDE12345.p8
# APPLE_API_KEY_ID=ABCDE12345
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
