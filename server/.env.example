# Public listener. Put TLS/reverse proxy in front for production.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/fly-safe.sqlite

# Public EVE application identifier. Never place a client secret in desktop code.
EVE_CLIENT_ID=722024be688548e4b022064636ecd652

# Cashier character. Refresh token must include esi-wallet.read_character_wallet.v1.
CASHIER_CHARACTER_ID=90000001
CASHIER_REFRESH_TOKEN=replace-with-cashier-refresh-token
# Recommended: persists a rotated refresh token with mode 0600.
CASHIER_REFRESH_TOKEN_PATH=./secrets/cashier-refresh-token
# Required only when the registered EVE app is confidential.
EVE_CLIENT_SECRET=

# Existing Ed25519 PKCS#8 private key whose public half is compiled into Fly Safe desktop.
# Do NOT generate a new random key during deployment: startup rejects keys the desktop cannot trust.
# Trusted public SPKI SHA-256: 5925643c4a5c4c61288737898ddfaacc7558422cd35d2f78d73f563c05cd7314
ENTITLEMENT_PRIVATE_KEY_PATH=./secrets/entitlement-private.pem
# Must match the key ID compiled into the same desktop release.
ENTITLEMENT_KEY_ID=fly-safe-2026-01

# Random high-entropy bearer used only by operational endpoints.
ADMIN_TOKEN=replace-with-at-least-32-random-characters

PUBLIC_BASE_URL=https://license.example.invalid
ESI_USER_AGENT=Fly-Safe/0.1 admin@example.invalid
ESI_COMPATIBILITY_DATE=2020-01-01

# Public-combat relay. Desktop users reach this server; only this server contacts zKillboard.
ZKILL_BASE_URL=https://zkillboard.com
R2Z2_BASE_URL=https://r2z2.zkillboard.com
ZKILL_RELAY_USER_AGENT=Fly-Safe/0.12.6 zkill-relay admin@example.invalid

WALLET_POLL_INTERVAL_SECONDS=60
RENEWAL_LEAD_SECONDS=86400
ENTITLEMENT_GRACE_SECONDS=172800
MAX_DEVICES_PER_CHARACTER=3
